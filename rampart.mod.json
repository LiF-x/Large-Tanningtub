{
  "schemaVersion": 1,
  "id": "Large-Tanningtub",
  "name": "LiFx Large Tanning Tub",
  "version": "0.0.1",
  "description": "Adds a Large Tanning Tub from LiF:MMO. Requires the LiFx framework to set $LiFx::createDataXMLS=true so the new object type gets imported to the DB on first start.",
  "authors": [
    "lif-x community"
  ],
  "loadOrderHint": 100,
  "files": {
    "overlay": [
      {
        "src": "mods/",
        "dest": "mods/"
      },
      {
        "src": "data/objects_types.xml",
        "dest": "data/objects_types.xml"
      },
      {
        "src": "data/recipe.xml",
        "dest": "data/recipe.xml"
      },
      {
        "src": "data/recipe_requirement.xml",
        "dest": "data/recipe_requirement.xml"
      },
      {
        "src": "yolauncher/modpack/mods/LiFx/",
        "dest": "yolauncher/modpack/mods/LiFx/"
      }
    ],
    "dataPatches": [
      {
        "target": "data/admin_lands_abilities.xml",
        "replace": "data/admin_lands_abilities.xml"
      },
      {
        "target": "data/cm_equipTypes.xml",
        "transform": "transforms/cm_equipTypes.xdt.xml"
      },
      {
        "target": "data/cm_objects.xml",
        "transform": "transforms/cm_objects.xdt.xml"
      },
      {
        "target": "data/skill_types.xml",
        "transform": "transforms/skill_types.xdt.xml",
        "mergeOps": "transforms/skill_types.merge.json"
      }
    ]
  }
}